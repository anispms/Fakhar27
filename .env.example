# --- Local dev (server.cjs / vendordatabase.cjs / productdatabase.cjs / databasepg.cjs) ---
# Copy this file to .env.local (or export these in your shell) and fill in
# your real local Postgres password. It is no longer hardcoded in the source.
PGHOST=localhost
PGUSER=postgres
PGPORT=5432
PGPASSWORD=
PGDATABASE=postgres

# --- Backend (Render web service env vars) ---
# Render's managed Postgres provides this automatically when you link it.
DATABASE_URL=postgres://user:password@host:5432/dbname
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# --- Frontend (Render static site env var, set at build time) ---
# Set this to the backend web service's URL once it's deployed, e.g.
# https://sabkuchbechoo-backend.onrender.com
VITE_API_URL=
